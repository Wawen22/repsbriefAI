# Apify trend ingestion. Keep all values empty in this committed template.
# APIFY_TOKEN and APIFY_WEBHOOK_SECRET are server-only Vercel/local secrets.
APIFY_TOKEN=
APIFY_WEBHOOK_SECRET=
APIFY_REDDIT_TASK_ID=
APIFY_GOOGLE_TRENDS_TASK_ID=

# Apify sources are fail-closed. Set a source to literal "true" only after its
# benchmark and rollout checks pass; all other values leave it disabled.
TREND_REDDIT_ENABLED=false
TREND_GOOGLE_TRENDS_ENABLED=false

# Positive USD ceiling approved for the daily Apify rollout review. Leave empty
# until the benchmark establishes a ceiling; an invalid value blocks rollout.
TREND_APIFY_DAILY_BUDGET_USD=
